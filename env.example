# Telegram API credentials (from https://my.telegram.org)
TG_APP_ID=123456
TG_APP_HASH=your_app_hash_here

# Your phone number for userbot authentication (with country code)
TG_PHONE_NUMBER=+79001234567

# String session for Docker deployment (generated by: go run ./cmd/auth)
# This is the preferred method - no file mounting needed
TG_STRING_SESSION=

# Session file path (optional fallback, only used if TG_STRING_SESSION is empty)
# SESSION_PATH=session.dat

# OpenAI-compatible API (base URL WITHOUT /chat/completions)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
# Alternatives:
# OmniRoute: http://localhost:20128/v1 (use its gateway API key)
# OpenCode Zen: https://opencode.ai/zen/v1
# OpenCode Go: https://opencode.ai/zen/go/v1
# Select a Chat Completions model with image input via DATING_MODEL below.
# Legacy OPENROUTER_API_KEY works only when LLM_BASE_URL is unset.

# API model ID for MBTI and messages; set explicitly for alternative endpoints
# DATING_MODEL=google/gemini-2.5-flash-lite-preview-06-2025

# System prompt for generating dating messages (optional)
# DATING_PROMPT='Your custom prompt here...'

# Temperature for dating messages (default: 0.7)
# DATING_TEMPERATURE=0.7

# System prompt for MBTI analysis from profile photo+bio (optional)
# Used by runtime MBTI classification before allowlist filtering
# DATING_MBTI_PROMPT='Return only MBTI type like INTJ'

# Allowed MBTI types for future filtering (comma-separated, case-insensitive)
# Normalized to uppercase during config load
# Default: INTJ,INFJ,ENTJ,ENFJ
# DATING_MBTI_ALLOWLIST=INTJ,INFJ,ENTJ,ENFJ

# Delay between dating bot actions (anti-spam protection)
# Format: Go duration string (e.g., "3s", "1500ms", "2s500ms")
# Default: 15s
# DATING_ACTION_DELAY=15s

# Enable filtering of low quality profiles (e.g., short or empty bio)
# Default: false
# DATING_SKIP_LOW_QUALITY=true

# Minimum bio length (in chars) to consider a profile "quality"
# Only used if DATING_SKIP_LOW_QUALITY is true
# Default: 50
# DATING_MIN_BIO_LENGTH=50

# Reply audit JSONL file path (set empty to disable)
# Default: /app/logs/replies.jsonl
# DATING_REPLY_AUDIT_LOG_PATH=/app/logs/replies.jsonl

# Webhook URL for reciprocal-like final payload delivery (empty disables)
# DATING_MATCH_WEBHOOK_URL=https://example.com/hooks/dating-match

# Optional Bearer token for webhook Authorization header
# DATING_MATCH_WEBHOOK_TOKEN=super-secret-token

# NOTE: Set this token equal to FORWARDER_WEBHOOK_AUTH_TOKEN when forwarding
# to the bundled match-forwarder service.

# Timeout for webhook POST request
# Format: Go duration string
# Default: 5s
# DATING_MATCH_WEBHOOK_TIMEOUT=5s

# Instance name for X-Dating-Instance-Name header
# Required when R2 persistence is enabled
# DATING_INSTANCE_NAME=prod-eu-1

# Profile dedupe TTL for persistent duplicate filtering
# Format: Go duration string
# Default: 72h
# DATING_PROFILE_DEDUP_TTL=72h

# Cloudflare R2 config for persistent dedupe and reply-audit storage (optional)
# When any R2 credential/bucket/endpoint variable is set, all R2 fields below
# become required and DATING_INSTANCE_NAME must be set.
# DATING_R2_BUCKET=dating-profiles
# DATING_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# DATING_R2_REGION=auto
# DATING_R2_ACCESS_KEY_ID=...
# DATING_R2_SECRET_ACCESS_KEY=...

# Match forwarder: Telegram bot token used to send forwarded match messages
# FORWARDER_BOT_TOKEN=123456789:AA...your_bot_token_here

# Match forwarder: destination chat ID for delivered notifications
# FORWARDER_TARGET_CHAT_ID=-1001234567890

# Match forwarder: bearer token expected in incoming webhook Authorization header
# Should match DATING_MATCH_WEBHOOK_TOKEN in the producer.
# FORWARDER_WEBHOOK_AUTH_TOKEN=super-secret-token

# Match forwarder: HTTP bind address (default: :8080)
# FORWARDER_BIND_ADDRESS=:8080

# Match forwarder: webhook endpoint path (default: /webhook/reciprocal-like-final)
# FORWARDER_WEBHOOK_PATH=/webhook/reciprocal-like-final

# Match forwarder: outbound Telegram API base URL (default: https://api.telegram.org)
# FORWARDER_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Match forwarder: HTTP client/server shutdown timeout (default: 10s)
# Format: Go duration string
# FORWARDER_HTTP_TIMEOUT=10s
